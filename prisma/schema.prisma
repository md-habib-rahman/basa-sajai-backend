generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ------------------------------------
// Better Auth Core Tables
// ------------------------------------

enum Role {
    SUPER_ADMIN
    ADMIN
    MODERATOR
}

model User {
    id            String    @id @default(cuid())
    name          String
    email         String    @unique
    emailVerified Boolean   @default(false)
    image         String?
    role          Role      @default(MODERATOR)
    isActive      Boolean   @default(false) // Deactivated by default
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]
}

model Session {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
    id                    String    @id @default(cuid())
    userId                String
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    idToken               String? // <--- ADD THIS FIELD
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
    id         String   @id @default(cuid())
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

// ------------------------------------
// Basa Sajai Business Models
// ------------------------------------

model Product {
    id                 String          @id @default(cuid())
    title              String
    sku                String          @unique
    imageUrl           String?
    stockQuantity      Int             @default(0)
    totalPurchasePrice Float           @default(0)
    unitPrice          Float           @default(0)
    shippingCost       Float           @default(0)
    marketingCost      Float           @default(0)
    packagingCost      Float           @default(0)
    totalLandedCost    Float           @default(0)
    sellingPrice       Float           @default(0) // Calculated (+40% revenue)
    actualSellingPrice Int             @default(0)
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt
    productCosting     ProductCosting?
    orderItems         OrderItem[]
}

model ProductCosting {
    id              String  @id @default(cuid())
    productId       String  @unique
    boxCost         Decimal @default(0) @db.Decimal(10, 2)
    accessoriesCost Decimal @default(0) @db.Decimal(10, 2)
    deliveryReturn  Decimal @default(0) @db.Decimal(10, 2)
    marketingCost   Decimal @default(0) @db.Decimal(10, 2)
    suggestedPrice  Decimal @db.Decimal(10, 2)
    actualSalePrice Decimal @db.Decimal(10, 2)
    status          String  @default("OK")
    offerNote       String?
    product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum PurchaserType {
    JOINT
    HABIB
    ROBIUL
}

model Investment {
    id                 String        @id @default(cuid())
    investmentDate     DateTime      @default(now())
    description        String
    purchaser          PurchaserType @default(JOINT)
    totalCost          Float         @default(0)
    habibContribution  Float         @default(0)
    robiulContribution Float         @default(0)
    notes              String?
    createdAt          DateTime      @default(now())
    updatedAt          DateTime      @updatedAt

    @@map("investment")
}

enum OrderStatus {
    PENDING
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
}

